# MultiCloudOps Backend — Environment Variables
# Copy this to .env and fill in your values

APP_NAME=MultiCloudOps API
APP_VERSION=2.0.0
DEBUG=true

# Database (Phase 1: SQLite, Phase 2: PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:////data/multicloudops.db
# DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/multicloudops

# Redis
REDIS_URL=redis://redis:6379

# Security
SECRET_KEY=change-me-in-production

# Mock mode (true = Phase 1, false = use real agents)
MOCK_MODE=true

# Agent settings
AGENT_HEARTBEAT_INTERVAL=30
AGENT_OFFLINE_THRESHOLD=90
METRICS_BROADCAST_INTERVAL=5

# Cloud credentials (Phase 3 — leave empty for mock mode)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AZURE_SUBSCRIPTION_ID=
# GCP_PROJECT_ID=
